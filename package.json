{
  "name": "layangan-duel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Adu layangan 3D di browser. Sim deterministik terpisah dari render, siap buat bot dan online.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "verify": "npm run test && npm run build",
    "serve": "tsx server/serve.ts",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "three": "^0.186.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/node": "^20.19.43",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.151.2"
  }
}
